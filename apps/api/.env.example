# Secret: supply a database URL through a secret manager outside local development.
# Required; use a dedicated QA database for QA and a separate production database.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/DATABASE
# Optional; defaults to 3000.
PORT=3000
# Local default: http://localhost:5173. Required in production: exact HTTPS public origin.
# CSRF requires this origin (or matching Referer) on unsafe requests; cookie sessions also need X-CSRF-Token from GET /auth/csrf.
CORS_ORIGIN=http://localhost:5173
# Production sets Secure on the session cookie and requires HTTPS.
NODE_ENV=development

# Per-instance fixed window, IP and normalized email+IP limits; no proxy headers are trusted.
# Multi-instance/serverless deployments require a shared limiter or equivalent edge protection.
# Socket addresses can identify the reverse proxy rather than the client: limits may be shared.
# Configure trusted proxy handling only after defining the actual proxy topology.
# When the account-pair bucket is full, IP limits remain active; a full IP bucket fails closed.
AUTH_RATE_WINDOW_MS=60000
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_IP_LIMIT=10
AUTH_REGISTER_IP_LIMIT=10
AUTH_REGISTER_ACCOUNT_IP_LIMIT=5
# Nest/Express default JSON and URL-encoded body limit is 100kb.
